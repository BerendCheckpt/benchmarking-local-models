# Copy to .env and replace every <placeholder>. .env is git- and docker-ignored.

# Port the app listens on; the page is published on 127.0.0.1 with the same port
PORT=<app-port>

# OAuth2 (Authorization Code + PKCE)
OAUTH_AUTH_URL=<authorize-endpoint-url>
OAUTH_TOKEN_URL=<token-endpoint-url>
OAUTH_CLIENT_ID=<client-id>
OAUTH_SCOPE=<space-separated-scopes, incl. offline_access>
# Must be registered for the client; its port must equal PORT
OAUTH_REDIRECT_URI=<redirect-uri>

# claude-agent container (recreated with the selected model)
AGENT_BASE_URL=<agent-url-as-seen-from-the-app-container>
AGENT_CONTAINER=<agent-container-name>
# Written to the agent's ANTHROPIC_BASE_URL; leave empty to keep its current value
AGENT_OLLAMA_URL=<ollama-url>
AGENT_ENV=<agent-env>
# Claude Code's output token maximum in the agent (CLAUDE_CODE_MAX_OUTPUT_TOKENS). Empty: 42000.
AGENT_MAX_OUTPUT_TOKENS=
# Docker volume (or host path) with the repo mirror, mounted read-only at /srv/repos.
# Leave empty to recreate the agent without one (code and FDS questions then fail).
AGENT_REPO_MIRROR=<mirror-volume>
# Seconds to wait for a labelizer generation call to the agent's /from-pdf. Empty: 21600 (6 h).
# The agent keeps a generation job running after the app stops waiting, so a short
# limit only stacks the next job on top of it. A local model can need about an hour.
GENERATE_TIMEOUT_S=
# NOT IMPLEMENTED YET: the implementation is planned for a later date, still to be decided.
# The thread limit: how many conversations the app may have in flight against the
# agent at once. A thread is one conversation (its turns always stay in order).
# More threads share one Ollama, so each answer gets slower, and Ollama's own
# OLLAMA_NUM_PARALLEL caps how many really run in parallel. Runs are sequential today.
#BENCHMARK_THREADS=1


# SSH (password) to the server that runs Ollama, for `ollama list`
OLLAMA_SSH_HOST=<ollama-ssh-host>
OLLAMA_SSH_PORT=<ollama-ssh-port>
OLLAMA_SSH_USER=<ssh-user>
OLLAMA_SSH_PASSWORD=<ssh-password>
# Optional host key pin, e.g. SHA256:abc... (the "Server host key" line of ssh -v)
OLLAMA_SSH_HOSTKEY_SHA256=

# SSH (private key) to the QA host with the agent's session transcripts, for
# messages that had a file. Not the Ollama server. Leave HOST empty to skip those messages.
QA_SESSIONS_SSH_HOST=<qa-sessions-ssh-host>
QA_SESSIONS_SSH_PORT=22
QA_SESSIONS_SSH_USER=<ssh-user>
# Host path of the private key; docker compose mounts it read-only at /run/secrets/qa_sessions_key
QA_SESSIONS_SSH_KEY_PATH=<path-to-private-key>
QA_SESSIONS_SSH_KEY_PASSPHRASE=
QA_SESSIONS_SSH_HOSTKEY_SHA256=

# RetailerIntegration Postgres (read-only), for `/benchmark-report … labels` on this PC
RI_PGHOST=<ri-postgres-host>
RI_PGPORT=5432
RI_PGDATABASE=RetailerIntegration
RI_PGUSER=<read-only-user>
RI_PGPASSWORD=<password>
# disable | require | verify-full
RI_PGSSLMODE=require

# Postgres (reached by container name on the shared network)
PG_NETWORK=<docker-network-of-postgres>
PGHOST=<postgres-host>
PGPORT=<postgres-port>
PGDATABASE=<database>
PGUSER=<user>
PGPASSWORD=<password>
