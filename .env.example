# Copy to .env and fill in. .env is git- and docker-ignored.

# OAuth2 (Authorization Code + PKCE), same client as the Postman setup
OAUTH_AUTH_URL=https://<login-host>/connect/authorize
OAUTH_TOKEN_URL=https://<login-host>/connect/token
OAUTH_CLIENT_ID=<client-id>
OAUTH_SCOPE=openid profile email roles offline_access ri.api backoffice.api authorization.api rfid.api website.api
OAUTH_REDIRECT_URI=http://127.0.0.1:4202

# claude-agent container (recreated with the selected model)
AGENT_BASE_URL=http://host.docker.internal:8090
AGENT_CONTAINER=claude-agent-local
AGENT_OLLAMA_URL=http://<ollama-host>:11434
AGENT_ENV=qa

# SSH (password) to the server that runs Ollama, for `ollama list`
OLLAMA_SSH_HOST=<ollama-host>
OLLAMA_SSH_PORT=22
OLLAMA_SSH_USER=
OLLAMA_SSH_PASSWORD=
# Optional host key pin, e.g. SHA256:abc... (the "Server host key" line of ssh -v)
OLLAMA_SSH_HOSTKEY_SHA256=

# Postgres (reached by container name on the shared network)
PG_NETWORK=local-model-benchmark_default
PGHOST=postgres
PGPORT=5432
PGDATABASE=n8n
PGUSER=n8n
PGPASSWORD=
